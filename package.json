{
  "name": "datve",
  "version": "1.0.0",
  "description": "Monorepo app dat ve xem phim: mobile, admin va api",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "npm run start --workspace api",
    "build": "npm run build --workspace api",
    "mobile": "npm run start --workspace mobile",
    "mobile:android": "npm run android --workspace mobile",
    "admin": "npm run dev --workspace admin",
    "api": "npm run dev --workspace api",
    "lint": "npm run lint --workspace admin && npm run lint --workspace api",
    "build:web": "npm run build --workspace admin && npm run build --workspace api"
  },
  "workspaces": [
    "apps/*"
  ],
  "keywords": [
    "movie-booking",
    "react-native",
    "nextjs",
    "mysql"
  ],
