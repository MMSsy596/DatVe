{
  "name": "datve",
  "version": "1.0.0",
  "description": "Monorepo app dat ve xem phim: mobile, admin va api",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "npm run start --workspace api",
    "build": "npm run build --workspace api",
    "mobile": "npm run start --workspace mobile",
    "user": "npm run web --workspace mobile",
    "mobile:android": "npm run android --workspace mobile",
    "admin": "npm run dev --workspace admin",
    "api": "npm run dev --workspace api",
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "node scripts/dev-local.mjs --web",
    "lint": "npm run lint --workspace admin && npm run lint --workspace api",
    "test": "npm run test --workspace api",
    "ui:check": "node scripts/ui-check.mjs",
    "typecheck:mobile": "npm --workspace mobile exec tsc -- --noEmit",
    "build:web": "npm run build --workspace admin && npm run build --workspace api",
    "verify": "npm run lint && npm run test && npm run typecheck:mobile && npm run build:web"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "@expo/metro-config": {
      "postcss": "8.5.12"
    },
    "@expo/plist": {
      "@xmldom/xmldom": "0.9.10"
    },
    "@tailwindcss/postcss": {
      "postcss": "8.5.12"
    },
    "next@16.2.4": {
      "postcss": "8.5.12"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.10"
    },
    "xcode": {
      "uuid": "14.0.0"
    }
  },
  "keywords": [
    "movie-booking",
    "react-native",
    "nextjs",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
